{
  "realm": "finora",
  "displayName": "FinoraOS",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "EMPLOYEE" },
      { "name": "FINANCE_OPERATOR" },
      { "name": "FINANCE_CONTROLLER" },
      { "name": "ENTERPRISE_ADMIN" },
      { "name": "AUDITOR" }
    ]
  },
  "clients": [
    {
      "clientId": "finora-web",
      "name": "FinoraOS Web",
      "enabled": true,
      "publicClient": false,
      "secret": "finora-web-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/api/auth/callback/keycloak"],
      "webOrigins": ["http://localhost:3000"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "Finora organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "organization_id",
            "claim.value": "demo-org",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "Finora API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "finora-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "finora-api",
      "name": "FinoraOS API",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
